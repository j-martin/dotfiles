#!/usr/bin/env bash

__source() {
  local sourced_file="$1"
  shift

  # shellcheck disable=1090
  if [[ -f "${sourced_file}" ]]; then
    source "${sourced_file}"
  fi
}

export GITHUB_WORK_ORG='nestoca'
export GOPRIVATE='github.com/nestoca,github.com/j-martin'
export WORK="$HOME/src/github.com/nestoca"
export GOPATH="$HOME"
export OP_BIOMETRIC_UNLOCK_ENABLED=true

export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8
export CDPATH=".:$WORK:$HOME:$HOME/src/github.com/j-martin:$GOWORK:$HOME/src/github.com/:$HOME/src/worktrees"
export VISUAL="emacsclient"
# export DOCKER_DEFAULT_PLATFORM=linux/amd64

if command -v fzf > /dev/null 2>&1 && ! declare -f __fzf_comprun > /dev/null; then
  eval "$(fzf --zsh)"
fi

test -e /usr/local/bin/brew \
  && export BREW_PREFIX="$(brew --prefix)"

GPG_TTY="$(tty)"
export GPG_TTY
export DO_NOT_TRACK=true

# Use '/usr/bin/ssh-add --apple-use-keychain ~/.ssh/*' to add existing keys
test -e "$TMPDIR/ssh-loaded" \
  || /usr/bin/ssh-add --apple-load-keychain && touch "$TMPDIR/ssh-loaded"

__source "$HOME/.private/profile"

# shellcheck source=.functions/all
source "$HOME/.functions/all"
_safe
# shellcheck source=.aliases
source "$HOME/.aliases"

# zsh's _compadd claims every command starting with '_' so our functions would
# otherwise complete compadd flags instead of falling back to file paths.
if [[ -n "${ZSH_VERSION:-}" ]]; then
  unset '_postpatcomps[_*]'
fi

export PATH="$GOPATH/bin:$HOME/.bin:$HOME/.local/bin:$PATH"

export PAGER='less -SRi'
export HOSTNAME="$HOST"

export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep"
export FZF_DEFAULT_COMMAND="rg --files --hidden --glob='!{.git,node_modules,out}' 2> /dev/null"

if [[ -z "$DISPLAY" ]] && [[ -n "$XDG_VTNR" ]] && [[ "$XDG_VTNR" -eq 1 ]]; then
  exec startx
fi

if [[ -n "$(pgrep gpg-agent)" ]]; then
  export GPG_AGENT_INFO
else
  # shellcheck disable=SC2046
  eval $(gpg-agent --daemon)
fi
