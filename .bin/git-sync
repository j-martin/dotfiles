#!/usr/bin/env bash
# `git sync`: abort if there are uncommitted changes (submodules ignored),
# pull, abort if unpushed commit titles contain `wip`, show unpushed changes, check them for secrets/machine specific paths
# with a local ollama model, then with the $AGENT (claude or copilot) if it found nothing,
# then confirm before pushing.
# GIT_DIR/GIT_WORK_TREE are inherited from `git --git-dir --work-tree sync`,
# so this also works for the dotfiles repo via `_git_or_home`/`home`.

set -o errexit
set -o pipefail

_LEAK_OLLAMA_MODEL='gemma3:12b'
_LEAK_AGENT_MODEL='claude-opus-5.5'

_clear() {
  if [[ -n "$TMUX" ]]; then
    tmux clear-history && tmux send-keys C-l
  else
    clear && printf '\e[3J'
  fi
}

_abort_if_uncommitted() {
  local uncommitted
  uncommitted="$(git status --short --ignore-submodules=all)"
  if [[ -n "$uncommitted" ]]; then
    echo "Uncommitted changes:"
    echo "$uncommitted"
    echo
    echo "Diff:"
    git --no-pager diff --ignore-submodules=all HEAD
    echo
    echo 'Commit or stash your changes before syncing.' >&2
    exit 1
  fi
}

_abort_if_wip() {
  local wip
  wip="$(git --no-pager log --format='%h %s' '@{upstream}..HEAD' | grep -iw 'wip' || true)"
  if [[ -n "$wip" ]]; then
    echo "WIP commits:"
    echo "$wip"
    echo
    echo 'Reword or squash WIP commits before syncing.' >&2
    exit 1
  fi
}

_show_unpushed() {
  echo "Commits:"
  git --no-pager log --oneline '@{upstream}..HEAD'

  echo
  echo "Diff:"
  git --no-pager diff '@{upstream}'

  echo
  echo "Modified files:"
  git --no-pager diff --name-only '@{upstream}'
  echo
}

_leak_prompt() {
  cat <<'EOF'
You are a security reviewer. Below is a git diff about to be pushed to a public repository.
Only consider added lines (starting with "+", excluding "+++" file headers).
Report:
- type "secret": API keys, tokens, passwords, private keys, credentials, auth headers, connection strings with credentials.
- type "path": absolute paths starting with /Users/ or /home/ (e.g. /Users/alice/foo, /home/bob/bar).
Do NOT report placeholders, environment variable references ($HOME, $PATH, ~/...), example values, or other system paths (/usr/bin, /opt/homebrew, /tmp, /etc).
Reply ONLY with JSON: {"findings": [{"type": "secret"|"path", "file": "...", "value": "<exact offending text>", "reason": "..."}]}
Use an empty findings array when there is nothing to report.

Diff:
EOF
}

# Prints the findings of a JSON reply; agents may wrap the JSON in prose or code fences.
_leak_findings() {
  local result="$1"
  # Keep only the outermost {...} block.
  result="${result#*\{}"
  result="{${result%\}*}}"
  # Small models over-report paths, so only keep paths that really are user specific.
  jq -r '
    [.findings[]?
      | select(.type != "path" or ((.value // "") | test("/(Users|home)/[^/\\s]+")))]
    | .[] | "- [\(.type)] \(.file): \(.value)\n  \(.reason)"
  ' <<<"$result" 2>/dev/null
}

# Reviewer is `ollama` or an $AGENT value as in ~/.functions/agents (`claude`, else copilot).
_leak_run() {
  local reviewer="$1" input="$2"
  case "$reviewer" in
    ollama) ollama run --format json --hidethinking --nowordwrap "$_LEAK_OLLAMA_MODEL" "$input" ;;
    claude) command claude -p "$input" --model "${_LEAK_AGENT_MODEL//./-}" --output-format text ;;
    *) command copilot -p "$input" --model "$_LEAK_AGENT_MODEL" --silent --no-custom-instructions ;;
  esac
}

# Returns 1 and prints the findings when leaks are found, exits when the check cannot run.
_leak_check_with() {
  local reviewer="$1" name="$2" input="$3"
  local result findings

  echo "Checking diff for secrets and machine specific paths with $name..."
  if ! result="$(_leak_run "$reviewer" "$input")"; then
    echo "Leak check failed to run ($name)." >&2
    exit 1
  fi
  if ! findings="$(_leak_findings "$result")"; then
    echo "Leak check returned invalid output ($name): $result" >&2
    exit 1
  fi
  if [[ -n "$findings" ]]; then
    echo "Possible secrets or machine specific paths found ($name):" >&2
    echo "$findings" >&2
    return 1
  fi
  echo "No leaks found ($name)."
}

# Gemma first; when it finds nothing, double check with the $AGENT using the same prompt.
_check_leaks() {
  local agent="${AGENT:-copilot}"
  local input
  input="$(_leak_prompt)"$'\n'"$(git --no-pager diff -U0 '@{upstream}')"

  if ! _leak_check_with ollama "$_LEAK_OLLAMA_MODEL" "$input" ||
    ! _leak_check_with "$agent" "$agent ($_LEAK_AGENT_MODEL)" "$input"; then
    echo 'Aborting.' >&2
    exit 1
  fi
  echo
}

_main() {
  _clear
  _abort_if_uncommitted

  if ! git pull; then
    echo 'Failed to pull from upstream.' >&2
    exit 1
  fi
  if [[ -z "$(git rev-list '@{upstream}..HEAD')" ]]; then
    echo "Nothing to push."
    exit 0
  fi

  _abort_if_wip
  _show_unpushed
  _check_leaks
  if gum confirm "Push to $(git rev-parse --abbrev-ref '@{upstream}')?"; then
    git push --no-verify
  fi
}

_main "$@"
