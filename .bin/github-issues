#!/usr/bin/env bash

set -o errexit
set -o pipefail

source "$HOME/.config/shell/functions/base"
source "$HOME/.config/shell/functions/git"
source "$HOME/.config/shell/functions/github"

_format () {
    jq -r '"\(.created_at) - \(if has("pull_request") then "PR | " else "" end)\(.title) \(.html_url)"'
}

_github_involved_issues \
    | _format \
    | sort -ur
