#!/usr/bin/env bash

alias m='mise'
alias mug='mise use --global'
alias mup='_mise_unlocked mise upgrade'
alias mupg='_mise_unlocked mise upgrade --global'
alias mr='mise run'
alias mrm='_mise_which_delete'
mub() { mise bootstrap packages use brew:"$1"; }
mubc() { mise bootstrap packages use brew-cask:"$1"; }

# Brew
alias bdump="mise bootstrap packages import --global"
alias bcleanup="mise bootstrap packages prune --dry-run"
alias bi="mise bootstrap packages use --global" # bi brew:<formula> or bi brew-cask:<cask>
