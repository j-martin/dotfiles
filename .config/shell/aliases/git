__git_push() {
  local current_branch
  current_branch="$(_git_current_branch)"
  if [[ "${current_branch}" == 'master' ]] || [[ "${current_branch}" == 'main' ]]; then
    _info "Do not push to ${current_branch}"
    return 1
  fi
  git push --no-verify "$@"
}
