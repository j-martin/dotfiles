#!/usr/bin/env bash

__HOME_SYNC_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles-sync"
__HOME_SYNC_FETCH_TTL_MINUTES=60

_home_git() {
  command git --work-tree="$HOME" --git-dir="$HOME/.files.git" "$@"
}

# Same logic as magit (jm/magit-status-or-dotfiles): use the current repo,
# or fall back to the dotfiles repo when not inside one.
_git_or_home() {
  if command git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
    command git "$@"
  else
    _home_git "$@"
  fi
}

_home_submodule_update() {
  (
    cd "$HOME" || return 1
    failed=0
    updated=()
    while read -r p; do
      [ $# -gt 0 ] && ! printf '%s\n' "$@" | grep -qxF "$p" && continue
      echo "==> $p"
      old=$(command git -C "$p" rev-parse HEAD 2> /dev/null)
      if [ -z "$old" ]; then
        _home_git submodule update --init --recursive --remote -- "$p" \
          && echo "initialized at $(command git -C "$p" rev-parse HEAD)" \
          || failed=1
        continue
      fi
      name=$(_home_git config --file .gitmodules --get-regexp '^submodule\..*\.path$' \
        | awk -v p="$p" '$2 == p { sub(/^submodule\./, "", $1); sub(/\.path$/, "", $1); print $1 }')
      branch=$(_home_git config --file .gitmodules --get "submodule.$name.branch" || echo HEAD)
      command git -C "$p" fetch --quiet origin || {
        failed=1
        continue
      }
      [ "$branch" = HEAD ] && ! command git -C "$p" rev-parse --verify --quiet origin/HEAD > /dev/null \
        && command git -C "$p" remote set-head origin --auto > /dev/null
      new=$(command git -C "$p" rev-parse --verify --quiet "origin/$branch") || {
        echo "cannot resolve origin/$branch"
        failed=1
        continue
      }
      if [ "$old" = "$new" ]; then
        echo "up to date"
        continue
      fi
      command git -C "$p" --no-pager dd "$old" "$new"
      gum confirm "Update $p to ${new:0:9}?" < /dev/tty || continue
      if _home_git submodule update --init --recursive --remote --no-fetch -- "$p"; then
        updated+=("$p")
      else
        failed=1
      fi
    done < <(_home_git ls-files --stage | awk '$1 == "160000" { print $4 }')
    [ "$failed" -ne 0 ] && echo "some submodules failed, not committing" && return 1
    [ ${#updated[@]} -eq 0 ] && return 0
    _home_git commit --message 'deps, sync submodules' -- "${updated[@]}"
  )
}

_home_submodule_remove() {
  [ $# -eq 0 ] && echo "usage: _home_submodule_remove <submodule-path>..." && return 1
  (
    cd "$HOME" || return 1
    for p in "$@"; do
      p="${p#"$HOME"/}"
      p="${p%/}"
      _home_git submodule deinit --force -- "$p" \
        && _home_git rm --force -- "$p" \
        && rm -rf "$HOME/.files.git/modules/$p" || return 1
    done
  )
}

__home_sync_fetch() {
  local fetch_head="$HOME/.files.git/FETCH_HEAD"
  if [[ -f "$fetch_head" ]] && [[ -z "$(find "$fetch_head" -mmin "+${__HOME_SYNC_FETCH_TTL_MINUTES}")" ]]; then
    return 0
  fi
  GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND='ssh -o BatchMode=yes' _home_git fetch --quiet origin
}

# Writes a one-line summary of how the dotfiles differ from their upstream to
# the cache file, or empties it when they are in sync. Submodules are ignored.
_home_sync_check() {
  local fetch_failed='' behind ahead dirty
  local problems=()

  __home_sync_fetch || fetch_failed=1
  read -r behind ahead < <(_home_git rev-list --left-right --count '@{upstream}...HEAD')
  dirty="$(_home_git status --porcelain --untracked-files=no --ignore-submodules=all | grep --count '')"

  if [[ "${behind:-0}" -gt 0 ]]; then
    problems+=("${behind} behind")
  fi
  if [[ "${ahead:-0}" -gt 0 ]]; then
    problems+=("${ahead} ahead")
  fi
  if [[ "${dirty}" -gt 0 ]]; then
    problems+=("${dirty} uncommitted")
  fi
  if [[ -n "$fetch_failed" ]]; then
    problems+=('fetch failed')
  fi

  local summary='' tmp="${__HOME_SYNC_CACHE}.$$"
  if [[ ${#problems[@]} -gt 0 ]]; then
    summary="$(printf '%s, ' "${problems[@]}")"
    summary="Dotfiles out of sync: ${summary%, }"
  fi
  _gnu mkdir --parents "$(dirname "$__HOME_SYNC_CACHE")"
  printf '%s' "$summary" > "$tmp"
  mv "$tmp" "$__HOME_SYNC_CACHE"
}

# Prints the warning cached by the previous shell, then refreshes it in the background.
_home_sync_status() {
  if [[ -s "$__HOME_SYNC_CACHE" ]]; then
    _warn "$(cat "$__HOME_SYNC_CACHE") (h status)"
  fi
  (_home_sync_check > /dev/null 2>&1 &)
}
