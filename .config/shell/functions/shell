#!/usr/bin/env bash

FMT_END="\e[0m"

FMT_GREEN="\e[32m"
FMT_RED="\e[31m"

FMT_BOLD="\e[1m"

_echo_green_bold() {
  echo -e "${FMT_GREEN}${FMT_BOLD}${*}${FMT_END}"
}

# Copies the given command followed by the current working directory to the clipboard.
__copy_command_with_pwd() {
  local command="$1"
  command="${command#"${command%%[![:space:]]*}"}"
  _clipboard_copy <<< "${command} (${PWD})"
}

# Copies the previously run command and the working directory to the clipboard.
_copy_last_command() {
  local offset=-2
  if [[ -n "${ZSH_VERSION:-}" ]]; then
    offset=-1
  fi
  __copy_command_with_pwd "$(fc -ln "${offset}" "${offset}")"
}

# Picks a command from the history with fzf (most recent first) and copies it with the working directory.
_copy_command_from_history() {
  local command
  command="$(fc -ln 1 | fzf --tac --no-sort --query "${*:-}")" || return
  __copy_command_with_pwd "${command}"
}

# Runs `which` on each name, then on the functions and aliases they reference, up to `--depth` levels (default 3).
# The output is also copied to the clipboard.
_which_recursive() {
  local depth=3
  if [[ "${1:-}" == '--depth' ]]; then
    depth="${2:-}"
    shift 2
  fi
  if [[ ! "${depth}" =~ ^[1-9][0-9]*$ || $# -eq 0 ]]; then
    echo "Usage: _which_recursive [--depth N] name..." >&2
    return 1
  fi
  local -A __which_recursive_seen=()
  local name output
  output="$(
    for name in "$@"; do
      __which_recursive_visit "${name}" 1 "${depth}"
    done
  )"
  printf '%s\n' "${output}"
  _clipboard_copy <<< "${output}" 2> /dev/null
  _info 'Copied to clipboard'
}

# Prints the first word of each command (start of line, after `|`, `;`, `&&`, `||`, `$(`, `(` or backtick) read from stdin, once each.
__which_recursive_commands() {
  # shellcheck disable=SC2016
  awk '
    {
      gsub(/\$\(|`|\|\||&&|[|;(]/, "\n")
      segment_count = split($0, segments, "\n")
      for (s = 1; s <= segment_count; s++) {
        word_count = split(segments[s], words, " ")
        for (w = 1; w <= word_count; w++) {
          if (words[w] ~ /^(if|then|else|elif|do|while|until|!|time|command|builtin|exec|noglob|nocorrect|[{}()])$/ || words[w] ~ /^[[:alpha:]_][[:alnum:]_]*=/) {
            continue
          }
          if (!seen[words[w]]++) {
            print words[w]
          }
          break
        }
      }
    }
  '
}

# Prints `which` for a name and recurses into the functions and aliases it calls.
# Relies on `__which_recursive_seen` from `_which_recursive` to show each name only once.
__which_recursive_visit() {
  local name="$1"
  local level="$2"
  local depth="$3"
  local definition body line tabs token
  if [[ -n "${__which_recursive_seen[${name}]:-}" ]]; then
    return
  fi
  __which_recursive_seen[${name}]=1
  if ((${#__which_recursive_seen[@]} > 1)); then
    echo
  fi
  case "$(whence -w -- "${name}" 2> /dev/null)" in
    *': function')
      definition="$(builtin which -- "${name}")"
      body="${definition}"
      ;;
    *': alias')
      definition="$(alias -L -- "${name}")"
      body="${aliases[${name}]}"
      ;;
    *)
      definition="# $(builtin which -- "${name}" 2>&1)"
      body=''
      ;;
  esac
  while IFS= read -r line; do
    tabs="${line%%[!$'\t']*}"
    printf '%s%s\n' "${tabs//$'\t'/  }" "${line#"${tabs}"}"
  done <<< "${definition}"
  if ((level >= depth)); then
    return
  fi
  while IFS= read -r token; do
    if [[ "${token}" == "${name}" ]]; then
      continue
    fi
    case "$(whence -w -- "${token}" 2> /dev/null)" in
      *': function' | *': alias')
        __which_recursive_visit "${token}" $((level + 1)) "${depth}"
        ;;
    esac
  done < <(__which_recursive_commands <<< "${body}")
}

# Lists aliases, functions, builtins and executables as `name<TAB>type<TAB>detail<TAB>code` lines for fzf.
# Loaded function definitions are written to files in the given directory, referenced by the `code` field.
__fzf_command_candidates() {
  local code_dir="$1"
  local name type detail code
  local index=0
  whence -wm '*' | while IFS= read -r line; do
    name="${line%: *}"
    type="${line##*: }"
    detail=''
    code=''
    case "${type}" in
      alias)
        detail="${aliases[${name}]}"
        ;;
      'global alias')
        detail="${galiases[${name}]}"
        ;;
      function)
        detail="${functions_source[${name}]}"
        if [[ "${functions[${name}]}" != *'builtin autoload -X'* ]]; then
          index=$((index + 1))
          code="${code_dir}/${index}"
          whence -f -- "${name}" > "${code}"
        fi
        ;;
      command)
        detail="${commands[${name}]}"
        ;;
    esac
    printf '%s\t%s\t%s\t%s\n' "${name}" "${type}" "${detail}" "${code}"
  done
}

# Picks an alias, function, builtin or executable with fzf and inserts it at the cursor.
__fzf_command_widget() {
  local word="${LBUFFER##* }"
  local code_dir selected
  code_dir="$(mktemp -d)"
  # shellcheck disable=SC2016
  selected="$(__fzf_command_candidates "${code_dir}" \
    | sort --unique --field-separator=$'\t' --key=1,1 \
    | fzf --height 70% --reverse --delimiter '\t' --tabstop 16 --nth 1 --with-nth 1..3 \
      --query "${word}" \
      --preview 'case {2} in
          function) echo {3}; if [ -s {4} ]; then bat --color always --plain --language zsh {4}; else bat --color always --plain {3}; fi ;;
          command) file --brief {3}; file --brief --mime {3} | grep -q text && bat --color always {3} ;;
          *) echo {3} ;;
        esac' \
      --preview-window 'down:60%' \
    | cut -f1)"
  rm -rf -- "${code_dir}"
  if [[ -n "${selected}" ]]; then
    LBUFFER="${LBUFFER%"${word}"}${selected} "
  fi
  zle reset-prompt
}

if [[ -n "${ZSH_VERSION:-}" && $- == *i* ]]; then
  zle -N __fzf_command_widget
  bindkey '^[e' __fzf_command_widget
fi
