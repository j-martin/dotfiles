#!/usr/bin/env bash

_AGENT_MODEL="claude-opus-5.5"
_AGENT_HOME_IGNORED_DIRS=(
  '.gnupg/'
)

_agent_home_entries() {
  (cd "$HOME" && _home_git ls-files --stage)
}

# Submodules are gitlinks (mode 160000): expose them as whole dirs, not as files
_agent_home_submodules() {
  _agent_home_entries | awk -F'\t' '$1 ~ /^160000 / { print $2 }'
}

_agent_home_tracked_files() {
  _agent_home_entries | awk -F'\t' '$1 !~ /^160000 / { print $2 }'
}

# Parent dir of each nested tracked file (not the top-level dir, so e.g. ~/.ssh isn't fully exposed)
_agent_home_dirs() {
  {
    # macOS sed has no long options, so use grep; the match keeps a trailing slash
    _agent_home_tracked_files | grep --only-matching --extended-regexp '^.*/'
    _agent_home_submodules | awk '{ print $0 "/" }'
  } | LC_ALL=C sort --unique | __agent_drop_nested_dirs | __agent_drop_ignored_dirs
}

__agent_drop_ignored_dirs() {
  local ignored
  local patterns=()
  for ignored in "${_AGENT_HOME_IGNORED_DIRS[@]}"; do
    patterns+=(--regexp "$ignored")
  done
  grep --invert-match --fixed-strings --line-regexp "${patterns[@]}"
}

# Expects C-sorted dirs with a trailing slash, so children directly follow their parent
__agent_drop_nested_dirs() {
  awk 'kept == "" || index($0, kept) != 1 { kept = $0; print }'
}

_agent_home_files() {
  _agent_home_tracked_files | grep --invert-match '/'
}

# A regular repo is any work tree that is not a submodule of the dotfiles repo
_agent_in_regular_repo() {
  local top
  top=$(command git rev-parse --show-toplevel 2> /dev/null) || return 1
  ! _agent_home_submodules | grep --quiet --line-regexp --fixed-strings "${top#"$HOME"/}"
}

# Runs the agent tool with the args, in a new Herdr tab when inside Herdr.
_agent_run() {
  local tool="$1"
  shift
  local cmd=()
  if [[ "$tool" == 'claude' ]]; then
    _info 'Starting Claude Code'
    cmd=(claude "$@" --model "${_AGENT_MODEL//./-}" --permission-mode acceptEdits)
  else
    _info 'Starting Copilot'
    cmd=(copilot "$@" --model "$_AGENT_MODEL")
  fi
  _info "$(printf '%q ' "${cmd[@]}")"
  if __agent_in_herdr; then
    __agent_herdr_new_tab "${cmd[@]}"
    return
  fi
  command "${cmd[@]}"
}

__agent_in_herdr() {
  [[ -n "${HC_TERMINAL_ID:-}" ]] && command -v herdr-app > /dev/null 2>&1
}

# Starts the command from the current dir in a new tab of the Herdr space of its repo (or of the dir outside a
# repo), or in a new space without one.
__agent_herdr_new_tab() {
  local root space
  root=$(command git rev-parse --show-toplevel 2> /dev/null) || root="$PWD"
  space=$(herdr-app ls | jq --raw-output --arg folder "$root" \
    'first(.spaces[] | select(.folder == $folder) | .id) // empty') || return 1
  if [[ -n "$space" ]]; then
    _info "Starting in a new tab of Herdr space ${space}"
    herdr-app 'do' tab.new "$(jq --null-input --compact-output --arg space "$space" --arg folder "$PWD" \
      '{space: $space, folder: $folder, argv: $ARGS.positional}' --args -- "$@")" > /dev/null
  else
    _info "Starting in a new Herdr space for ${PWD}"
    herdr-app 'do' space.new "$(jq --null-input --compact-output --arg folder "$PWD" \
      '{folder: $folder, argv: $ARGS.positional}' --args -- "$@")" > /dev/null
  fi
}

# Claude prompts for every --add-dir not marked trusted in ~/.claude.json, so pre-trust them
__agent_claude_trust_dirs() {
  local config="${HOME}/.claude.json"
  local tmp
  if [[ ! -f "$config" ]]; then
    return 0
  fi
  tmp=$(mktemp "${config}.XXXXXX") || return 1
  if jq '.projects = (.projects // {}) | reduce $ARGS.positional[] as $dir (.; .projects[$dir].hasTrustDialogAccepted = true)' \
    "$config" --args "$@" > "$tmp"; then
    command mv -f "$tmp" "$config"
  else
    command rm -f "$tmp"
    _warn 'Failed to pre-trust Claude directories'
  fi
}

_agent_tool() {
  # force copilot until the claude folder trust regression is fixed.
  echo "${AGENT:-copilot}"
  # echo copilot
}

# Start an agent on the dotfiles with every tracked home dir exposed, working
# from ~/.hammerspoon, regardless of the current directory.
# Set AGENT=claude to use Claude Code instead of Copilot.
_agent_home() {
  local tool
  tool=$(_agent_tool)
  (
    local args=()
    local dirs=()
    local dir file

    while IFS= read -r dir; do
      dirs+=("${HOME}/${dir%/}")
      args+=(--add-dir "${HOME}/${dir%/}")
    done < <(_agent_home_dirs)

    if [[ "$tool" == 'claude' ]]; then
      __agent_claude_trust_dirs "${dirs[@]}"
    fi

    while IFS= read -r file; do
      if [[ "$tool" == 'claude' ]]; then
        args+=(--allowedTools "Read(~/${file})" --allowedTools "Edit(~/${file})")
      else
        # Copilot has no read(path) rule; write(path) needs an absolute path to match a single file
        args+=(--allow-tool "write(${HOME}/${file})")
      fi
    done < <(_agent_home_files)

    cd "${HOME}/.hammerspoon" || return 1
    _agent_run "$tool" "$@" "${args[@]}"
  )
}

# Same logic as _git_or_home: start in the current repo, or fall back to
# _agent_home. Set AGENT=claude to use Claude Code instead of Copilot.
_agent() {
  if _agent_in_regular_repo; then
    _agent_run "$(_agent_tool)" "$@"
    return
  fi
  _agent_home "$@"
}
