{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "Lua 5.4",
  "diagnostics.globals": ["hs", "spoon"],
  "workspace.library": ["./"],
  "workspace.ignoreDir": ["Spoons"],
  "diagnostics.unused-local": "Error",
  "diagnostics.unused-function": "Error",
  "diagnostics.unused-label": "Error",
  "diagnostics.unused-vararg": "Error",
  "diagnostics.unreachable-code": "Error",
  "diagnostics.code-after-break": "Error",
  "diagnostics.empty-block": "Error",
  "Lua.type.checkLevel": "Standard",
  "Lua.type.weakUnionCheck": true,
  "Lua.type.unknownFieldsAsAny": true
}
